flowchart TD
    %% 1. GATEWAY & INGESTION LAYER
    subgraph S1 ["1. Gateway & Ingestion Layer"]
        TG["Telegram Bot API"]
        WA["WhatsApp Cloud API"]
        REST_IN["REST API Client"]

        TG & WA & REST_IN --> ADAPTER["Channel Adapter<br/>(Normalizes to UserSubmission)"]
        ADAPTER --> INGEST_API["FastAPI Intake Service<br/>(Synchronous ACK &lt;15ms)"]

        INGEST_API --> PG_STATE[("PostgreSQL Durable State Store<br/>(Source of Truth & Audit Trail)")]
        INGEST_API --> REDIS_QUEUE["Redis Stream<br/>(Ephemeral Task Queue)"]
    end

    %% 2. PREPROCESSING & INTENT CLASSIFICATION
    subgraph S2 ["2. Normalization, Extraction & Intent Routing"]
        REDIS_QUEUE --> WORKER["Background Worker Pool<br/>(Celery / ARQ)"]
        WORKER --> DEOBF["NFKC De-Obfuscator & Canonicalizer<br/>(Recomposition, Zero-Width Strip, Confusables)"]
        DEOBF --> ENT_EXTRACT["Deterministic Entity Extractor<br/>(Regex for E.164 Phones, UPI VPAs, Domains)"]
        ENT_EXTRACT --> INTENT_JEV["Jev Intent Classifier<br/>(Sub-30ms Typed Categorical Decision)"]
    end

    %% 3. FAST-PATH CACHE & THREAT GRAPH
    subgraph S3 ["3. Cache & Relational Graph Triage"]
        INTENT_JEV --> CACHE_TRIAGE{"Tri-Pass Cache & Graph Check"}
        CACHE_TRIAGE --> LSH["MinHash LSH Index<br/>(Masked 3-Grams)"]
        CACHE_TRIAGE --> ONNX["ONNX Embedding Centroids<br/>(all-MiniLM-L6-v2)"]
        CACHE_TRIAGE --> GRAPH["Bipartite Threat Graph<br/>(Indexed Phone / UPI / Domain)"]

        LSH & ONNX & GRAPH -- Hit --> EVID_VALIDATE["Prior Evidence Re-Validator<br/>(Validates cached findings against current entities)"]
        EVID_VALIDATE -- Validated Hit --> FAST_OUT["Fast Provisional Verdict<br/>(&lt;1s Return)"]
    end

    %% 4. JEV INQUEST & DIRECTIVE SYNTHESIS
    subgraph S4 ["4. Jev Magistrate: Inquest & Directives (Phase 1)"]
        CACHE_TRIAGE -- Cache Miss --> JEV_INQUEST{"Jev Magistrate Inquest<br/>(src/vouch/jev.py)"}
        JEV_INQUEST -->|Single-Vector Text| FAST_PLAN["Deterministic Fast-Path<br/>(&lt;0.5ms Default Directives)"]
        JEV_INQUEST -->|Composite / Multimodal| COMP_PLAN["Investigation Planner<br/>(Typed Pydantic InvestigationPlan)"]
    end

    %% 5. DEEP INVESTIGATION ENGINE (ASYMMETRIC GATHERING DAG)
    subgraph S5 ["5. Asymmetric Gathering DAG & Blackboard"]
        FAST_PLAN & COMP_PLAN --> GATHER_FORK["Parallel Branch Execution"]
        GATHER_FORK --> ACCUSER["Agent 1: Accuser (Fraud Intelligence)<br/>• Abuse.ch URLhaus / ThreatFox / SearXNG"]
        GATHER_FORK --> DEFENDER["Agent 2: Defender (Institutional Verifier)<br/>• phonenumbers + 160s / RDAP / RBI IFSC"]

        ACCUSER & DEFENDER --> AIRGAP_EXTRACT["Air-Gapped Extraction Worker<br/>(Generative LLM, Zero Tools, Zero Network)"]
        AIRGAP_EXTRACT --> CODE_GATE["Deterministic Code Gate<br/>• Allowlist Test<br/>• Substring Grounding<br/>• Entailment NLI Verification"]

        CODE_GATE --> BLACKBOARD[("Strict Structured Blackboard<br/>(Pydantic Structs Only — Zero Free-Text)")]
        
        %% Contradiction Checking & Adjudication
        BLACKBOARD <--> AUDITOR["Agent 3: Contradiction Auditor<br/>(Air-Gapped Anomaly & Clash Detector)"]
        BLACKBOARD --> JEV_ADJUDICATE{"Jev Magistrate (Phase 2: Adjudication)<br/>(Evaluates Directives & Sufficiency)"}
        
        JEV_ADJUDICATE -- Round &lt; 2 & Clashes Found --> GATHER_FORK
    end

    %% 6. DECISION, VERIFICATION & OUTPUT
    subgraph S6 ["6. Decision, Calibration & Output Layer"]
        JEV_ADJUDICATE -- Sufficient --> UNCERTAINTY_GATE{"Uncertainty Routing Gate<br/>(Phase 1: Threshold / Phase 2: Conformal ICP)"}

        %% HITL Loop with Explicit Return Path
        UNCERTAINTY_GATE -- Ambiguous Set --> HITL_QUEUE["Human-in-the-Loop Review Queue"]
        HITL_QUEUE --> HUMAN_VERDICT["Operator Review & Signed Label"]
        HUMAN_VERDICT --> HITL_RETURN["HITL Return Pipeline<br/>(Persist DB -> Graph -> Dispatch)"]

        %% Automated Output Path
        UNCERTAINTY_GATE -- Decisive Set --> DOSSIER["Polymorphic Dossier Synthesizer<br/>(Debunked claims, verified citations, action advice)"]
        HITL_RETURN --> DOSSIER

        DOSSIER --> GRAPH_MUTATE["Versioned Graph Mutation<br/>(Rollback-enabled node/edge updates, 30-day TTL)"]
        GRAPH_MUTATE --> IDEMPOTENT_DISPATCH["Idempotent Dispatcher<br/>(Key: submission_id + stage)"]
        FAST_OUT --> IDEMPOTENT_DISPATCH
    end

    IDEMPOTENT_DISPATCH --> TG_OUT["Telegram Bot Dispatch"]
    IDEMPOTENT_DISPATCH --> WA_OUT["WhatsApp Cloud API Dispatch"]
    IDEMPOTENT_DISPATCH --> REST_OUT["REST API Response"]